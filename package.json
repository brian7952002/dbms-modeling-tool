{
  "name": "dbms-modeling-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based modelling tool for database design: conceptual EER, logical relational and physical storage models, with live checking and SQL generation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^5.0.0"
  }
}
