# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> API -> Project URL and anon/public key.
#
# Both values are safe to publish: the anon key only grants what row-level
# security allows, and every table in supabase/schema.sql restricts rows to
# their owner (plus anything explicitly published).
#
# Leave these unset to build a local-only version with no accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
